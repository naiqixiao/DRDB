DB_USER=drdb
DB_PASS=replace-with-a-database-password
DB_NAME=DRDB
DB_HOST=localhost
DB_DIALECT=mariadb
JWT_KEY=replace-with-a-long-random-jwt-secret
TIMEZONE=America/Toronto
FRONTEND_URL=http://localhost:8080

# Shared AI provider config, used by every AI feature unless a feature-level
# *_PROVIDER override is set below. Default is a lab-hosted OpenAI-compatible
# endpoint (defaults below point at the lab's NInfer server); Ollama and Groq
# remain available as alternatives.
AI_PROVIDER=local
AI_TIMEOUT_MS=15000

# OpenAI-compatible local/lab endpoint (no auth). Get the model ID from
# GET /v1/models. Reasoning/thinking is off by default for Qwen3-style
# servers (LOCAL_LLM_ENABLE_THINKING=true to re-enable it).
LOCAL_LLM_BASE_URL=http://130.113.218.247:8080/v1
LOCAL_LLM_MODEL=Qwen3.8-27B
# Optional. Set only if the endpoint requires authentication.
# LOCAL_LLM_API_KEY=replace-with-local-api-key
# Optional. Enable only if the server supports response_format=json_object.
LOCAL_LLM_JSON_MODE=false
LOCAL_LLM_ENABLE_THINKING=false

# For local Ollama instead:
# AI_PROVIDER=ollama
# OLLAMA_URL=http://127.0.0.1:11434/api/chat
# OLLAMA_MODEL=gemma3

# For the Groq cloud provider (only for training-set/de-identified testing):
# AI_PROVIDER=groq
# GROQ_API_KEY=replace-with-a-groq-api-key
# GROQ_MODEL=openai/gpt-oss-20b

# Optional AI-assisted email personalization + polishing
AI_EMAIL_ENABLED=false
AI_EMAIL_ALLOW_REAL_DATA=false
# AI_EMAIL_PROVIDER=local   # overrides AI_PROVIDER for this feature only

# Optional AI family participation summary + intention-to-participate assessment
AI_FAMILY_SUMMARY_ENABLED=false
AI_FAMILY_SUMMARY_ALLOW_REAL_DATA=false
# AI_FAMILY_SUMMARY_PROVIDER=local   # overrides AI_PROVIDER for this feature only
