DB_USER=drdb
DB_PASS=replace-with-a-database-password
DB_NAME=DRDB
DB_HOST=localhost
DB_DIALECT=mariadb
JWT_KEY=replace-with-a-long-random-jwt-secret
TIMEZONE=America/Toronto
FRONTEND_URL=http://localhost:8080

# Optional AI-assisted email personalization
AI_EMAIL_ENABLED=false
AI_EMAIL_PROVIDER=groq
AI_EMAIL_ALLOW_REAL_DATA=false
AI_EMAIL_TIMEOUT_MS=15000
GROQ_API_KEY=replace-with-a-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b

# For local Ollama instead of Groq:
# AI_EMAIL_PROVIDER=ollama
# OLLAMA_URL=http://127.0.0.1:11434/api/chat
# OLLAMA_MODEL=gemma3
