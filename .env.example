# Copy this file to .env. Do not commit the resulting file.
DB_USER=drdb
DB_PASS=replace-with-a-long-random-database-password
DB_ROOT_PASS=replace-with-a-different-long-random-root-password
JWT_KEY=replace-with-a-long-random-jwt-secret

# The public address users open in a browser. Use https in production.
FRONTEND_URL=http://localhost:8080
URL=http://localhost:8080
HTTP_PORT=8080
TIMEZONE=America/Toronto

# Optional AI features (email personalization/polishing, family participation
# summary). Keep cloud testing limited to training-set/de-identified families
# until your lab approves real-data use. Default provider is the lab's
# OpenAI-compatible local endpoint (defaults below point at the lab's NInfer
# server; override LOCAL_LLM_* to point at any other OpenAI-compatible host).
AI_PROVIDER=local
AI_TIMEOUT_MS=15000
LOCAL_LLM_BASE_URL=http://130.113.218.247:8080/v1
LOCAL_LLM_MODEL=Qwen3.8-27B
# Optional. Set only if the endpoint requires authentication.
# LOCAL_LLM_API_KEY=replace-with-local-api-key
# Optional. Enable only if the server supports response_format=json_object.
LOCAL_LLM_JSON_MODE=false
# Disables chain-of-thought/reasoning output on Qwen3-style servers.
LOCAL_LLM_ENABLE_THINKING=false

AI_EMAIL_ENABLED=false
AI_EMAIL_ALLOW_REAL_DATA=false

AI_FAMILY_SUMMARY_ENABLED=false
AI_FAMILY_SUMMARY_ALLOW_REAL_DATA=false

# For a local Ollama provider instead:
# AI_PROVIDER=ollama
# OLLAMA_URL=http://127.0.0.1:11434/api/chat
# OLLAMA_MODEL=gemma3
# For the Groq cloud provider instead (training-set/de-identified testing only):
# AI_PROVIDER=groq
# GROQ_API_KEY=replace-with-a-groq-api-key
# GROQ_MODEL=openai/gpt-oss-20b

# Optional: lets multiple independent DRDB deployments share one Docker host.
# COMPOSE_PROJECT_NAME=drdb
